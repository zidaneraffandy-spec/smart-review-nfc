# Dari Upstash Console > database Anda > tab REST API
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=isi_token_read_write_di_sini

# Akun admin. Hash dibuat dengan: npm run hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:isi_salt:isi_hash

# Lama sesi admin (detik). 28800 = 8 jam
SESSION_TTL_SECONDS=28800
